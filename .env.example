# Owner keys for api/ai.js. Set these in the Vercel project environment.
# Do not put them in website JavaScript, localStorage, or sessionStorage.

# OpenRouter and Space Bunny Alpha.
OPENROUTER_API_KEY=

# Vercel AI Gateway. If this is empty, the relay uses VERCEL_OIDC_TOKEN.
# Vercel can set VERCEL_OIDC_TOKEN for the project. Do not copy it here.
AI_GATEWAY_API_KEY=

# Gemini API. The relay sends this as the x-goog-api-key header.
GEMINI_API_KEY=

# NVIDIA NIM.
NVIDIA_API_KEY=

# LLMAPI (https://api.llmapi.ai).
LLM_API_KEY=
